# Render Environment Variables Template for BizPilot AI
# Fill these in your Render Web Service -> Environment Settings dashboard
# NEVER commit real secrets to source control!

# Flask App Configuration
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-random-secure-secret-key
PORT=10000

# Database Configuration (Render automatically injects DATABASE_URL for Postgres)
DATABASE_URL=postgresql://bizpilot_user:password@dpg-xxxx-a.render.com/bizpilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Security & API Authentication
API_KEY=your-strong-production-api-key

# Optional Webhook Integration (URL to POST completed workflow job results)
WEBHOOK_URL=https://your-service.com/api/webhooks/bizpilot

# AI Provider Keys (Optional - Rule-based fallback executes automatically if left empty)
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=groq
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_RULE_BASED_FALLBACK=true
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=1

# Memory Limits
SHORT_TERM_MEMORY_LIMIT=8
LONG_TERM_MEMORY_LIMIT=5

# Location Settings for Weather Tool Proxy
WEATHER_LATITUDE=9.9252
WEATHER_LONGITUDE=78.1198
WEATHER_LOCATION=Madurai
